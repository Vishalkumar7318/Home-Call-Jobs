
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'vishal731808@gmail.com';
    }

    // Public job listings: everyone can read, only admin can edit
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public website settings: everyone can read, only admin can edit
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Employee information: admin only until ownership rules are configured
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    // Attendance records: admin only until ownership rules are configured
    match /attendance/{attendanceId} {
      allow read, write: if isAdmin();
    }

    // User records: admin only
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
