
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'vishal731808@gmail.com';
    }

    function ownsEmployee(employeeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employees/$(employeeId)) &&
        get(/databases/$(database)/documents/employees/$(employeeId)).data.authUid == request.auth.uid;
    }

    // Public job listings: everyone can read, only admin can edit
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public website settings: everyone can read, only admin can edit
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Employees can read only their own profile; only admins can manage records.
    match /employees/{employeeId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.authUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Employees can read and submit attendance only for their own employee ID.
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || ownsEmployee(resource.data.employeeId);
      allow create: if isAdmin() || ownsEmployee(request.resource.data.employeeId);
      allow update: if isAdmin() ||
        (ownsEmployee(resource.data.employeeId) &&
          request.resource.data.employeeId == resource.data.employeeId);
      allow delete: if isAdmin();
    }

    // User records: admin only
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
